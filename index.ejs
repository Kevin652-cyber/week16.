<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kevin Kottri CV</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <div>
        <h1><%= person.fName %> <%= person.lName %></h1>
        <p>Vanus: <%= person.age %></p>
        <p>Veebiarendaja</p>
    </div>

    <button>VÕTA ÜHENDUST</button>
</header>

<main>

    <div class="left">

        <div class="photo">
            <img id="cvPilt" src="image/pilt1.jpg" alt="Minu CV pilt">
        </div>

        <section>
            <h2>HARIDUS</h2>
            <ul>
                <li>Tallinna Tehnikakõrgkool 2024-2027<br>
                    (Autotehnika eriala)
                </li>
            </ul>
        </section>

        <section>
            <h2>TÖÖKOGEMUS</h2>
            <ul>
                <li>Veebirakenduste looja 2023-2025</li>
            </ul>
        </section>

    </div>
    <div class="right">

    <section>
        <h2>LISAKOMPETENTSID JA KVALIFIKATSIOON</h2>
        <ul>
            <li>Hea suhtleja</li>
            <li>Kiire õppimisvõime</li>
            <li>Huvi areneda</li>
        </ul>
    </section>

    <section>
        <h2>KEELED</h2>
        <ul>
            <li>Eesti keel - väga hea</li>
            <li>Inglise keel - hea</li>
        </ul>
    </section>

    <section>
        <h2>KONTAKTANDMED</h2>
        <ul>
            <li>Telefon: +372 5555 5555</li>
            <li>E-post: <%= person.email %></li>
        </ul>
    </section>

</div>

</main>
<script src="script.js"></script>
<script src="app.js"></script>

</body>
</html>